#!/bin/bash
# Silent launcher for the .app bundle - runs with no visible Terminal window.
# Deliberately does NOT use "exec npm start" for the final launch: exec
# replaces this process outright, so a failure inside npm start would have
# nowhere to report to and the app would just silently fail to open with no
# visible error - the same class of bug Setup.bat had on Windows.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$DIR"

# A quarantined (freshly downloaded) .app is run from a read-only copy under
# /private/var/.../AppTranslocation/, where the project folder isn't. Say so
# instead of failing with a generic error.
if [[ "$DIR" == */AppTranslocation/* ]] || [ ! -f "$DIR/package.json" ]; then
  osascript -e 'display alert "Run Setup First" message "macOS is blocking this app from finding its project folder (it was downloaded from the internet). Double-click Setup.command in the project folder once, then open the app again." as critical'
  exit 1
fi

# GUI-launched apps on macOS don't source .zshrc/.bash_profile, so Homebrew's
# node install (or a manually-downloaded one) may not be on PATH here even
# though it works fine from Terminal.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v npm >/dev/null 2>&1; then
  osascript -e 'display alert "Node.js Not Found" message "Install Node.js from nodejs.org, then try opening this again." as critical'
  exit 1
fi

npm start
status=$?
if [ $status -ne 0 ]; then
  osascript -e 'display alert "Research Recruitment Dashboard Failed to Start" message "Something went wrong launching the app. Open Terminal in this folder and run ./setup.sh to see the full error." as critical'
fi
exit $status
